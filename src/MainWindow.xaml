<!-- Loaded at runtime with XamlReader; PanelWindow wires up the named elements. -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Margin="18"
      TextElement.FontFamily="SF Pro Text, Segoe UI"
      TextElement.FontSize="13"
      TextElement.Foreground="{DynamicResource Text}"
      TextOptions.TextFormattingMode="Ideal">
  <Grid.Resources>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>

    <Style x:Key="Title" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBg}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="14,12,14,14"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- Rounded pill button; Tag="selected" fills it with the accent color. -->
    <Style x:Key="Chip" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ChipBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border Background="{TemplateBinding Background}" CornerRadius="8"/>
              <Border x:Name="Hover" Background="{DynamicResource HoverOverlay}" CornerRadius="8" Opacity="0"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.7"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Tag" Value="selected">
          <Setter Property="Background" Value="{DynamicResource Accent}"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Chip}">
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="Segment" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="2">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Circle" TargetType="Button">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Ellipse Fill="{DynamicResource TrackBg}"/>
              <Ellipse x:Name="Hover" Fill="{DynamicResource HoverOverlay}" Opacity="0"/>
              <Path Data="M0,0 L7,7 M7,0 L0,7" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.6"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- iOS-style toggle switch. -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="40" Height="24" CornerRadius="12" Background="{DynamicResource SwitchOff}">
              <Ellipse Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                <Ellipse.RenderTransform>
                  <TranslateTransform x:Name="KnobShift"/>
                </Ellipse.RenderTransform>
                <Ellipse.Effect>
                  <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.25"/>
                </Ellipse.Effect>
              </Ellipse>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource SwitchOn}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <!-- The shadow lives on its own layer so the text above stays crisp. -->
  <Border x:Name="ShadowCard" CornerRadius="16" Background="{DynamicResource WindowBg}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.2" Color="Black"/>
    </Border.Effect>
  </Border>

  <Border CornerRadius="16" Background="{DynamicResource WindowBg}"
          BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
    <StackPanel Margin="16,14,16,12">

      <!-- Header -->
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Width="34" Height="34" CornerRadius="9">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#FFD60A" Offset="0"/>
              <GradientStop Color="#FF9500" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <Viewbox Width="20" Height="20">
            <Grid Width="24" Height="24">
              <Path Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Data="M17,12 A5,5 0 1 1 7,12 A5,5 0 1 1 17,12 Z M12,1 L12,3 M12,21 L12,23 M4.22,4.22 L5.64,5.64 M18.36,18.36 L19.78,19.78 M1,12 L3,12 M21,12 L23,12 M4.22,19.78 L5.64,18.36 M18.36,5.64 L19.78,4.22"/>
            </Grid>
          </Viewbox>
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Display" FontSize="15" FontWeight="SemiBold"/>
          <Button x:Name="MonitorButton" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="-2,-1,0,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="MonitorName" Text="Looking for monitors..."/>
              <Path x:Name="MonitorChevron" Data="M0,0 L3.5,3.5 L7,0" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.4"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="5,1,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource Circle}" VerticalAlignment="Top" ToolTip="Close"/>
      </Grid>

      <!-- Brightness and contrast -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid Margin="0,0,0,8">
            <TextBlock Text="Brightness" Style="{StaticResource Title}"/>
            <TextBlock x:Name="BrightnessText" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
          </Grid>
          <ContentControl x:Name="BrightnessHost" Focusable="False"/>
          <UniformGrid x:Name="PresetGrid" Rows="1" Margin="-3,10,-3,0"/>
          <Grid Margin="0,16,0,8">
            <TextBlock Text="Contrast" Style="{StaticResource Title}"/>
            <TextBlock x:Name="ContrastText" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
          </Grid>
          <ContentControl x:Name="ContrastHost" Focusable="False"/>
        </StackPanel>
      </Border>

      <!-- Input source -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid Margin="0,0,0,8">
            <TextBlock Text="Input" Style="{StaticResource Title}"/>
            <TextBlock x:Name="InputText" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
          </Grid>
          <Border Background="{DynamicResource SegBg}" CornerRadius="9" Padding="2" Height="32">
            <Grid x:Name="SegGrid">
              <Border x:Name="SegIndicator" CornerRadius="7" Background="{DynamicResource SegSelected}" HorizontalAlignment="Left" Visibility="Hidden">
                <Border.RenderTransform>
                  <TranslateTransform/>
                </Border.RenderTransform>
                <Border.Effect>
                  <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.12"/>
                </Border.Effect>
              </Border>
              <UniformGrid x:Name="SegButtons" Rows="1"/>
            </Grid>
          </Border>
          <Border x:Name="ConfirmPanel" Visibility="Collapsed" Margin="0,10,0,0" CornerRadius="10" Background="{DynamicResource WarningBg}" Padding="12,10">
            <StackPanel>
              <TextBlock x:Name="ConfirmText" TextWrapping="Wrap" LineHeight="18"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="ConfirmCancel" Style="{StaticResource Chip}" Content="Cancel" MinWidth="76" Background="{DynamicResource CardBg}"/>
                <Button x:Name="ConfirmOk" Style="{StaticResource Primary}" Content="Switch" MinWidth="76" Margin="8,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Settings -->
      <Border Style="{StaticResource Card}" Padding="14,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Open at Login"/>
            <TextBlock Text="Starts quietly in the system tray" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
          </StackPanel>
          <CheckBox x:Name="LoginSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- Footer -->
      <Grid Margin="2,0,2,0">
        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,0,60,0" VerticalAlignment="Center"/>
        <Button x:Name="QuitButton" Style="{StaticResource Ghost}" Content="Quit" HorizontalAlignment="Right"/>
      </Grid>
    </StackPanel>
  </Border>
</Grid>
